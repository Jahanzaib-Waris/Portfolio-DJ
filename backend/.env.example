# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Required in production (e.g. https://your-api.vercel.app) so Django trusts
# admin/CSRF-protected POST requests coming from your deployed domain.
CSRF_TRUSTED_ORIGINS=

# CORS (comma-separated origins allowed to call the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit for the public Request a Quote form, in DRF throttle syntax
# (e.g. 5/hour, 20/day). Leave unset for the 5/hour default.
QUOTE_THROTTLE_RATE=5/hour

# How many proxies sit in front of Django, so throttling reads the real client
# IP from X-Forwarded-For instead of a spoofable value. Set to 1 on Vercel.
# Leave blank for local development (no proxy).
NUM_PROXIES=

# Supabase Postgres (leave blank to fall back to local SQLite for development)
# Get these from Supabase project settings -> Database -> Connection pooling
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Supabase Storage (leave blank to fall back to local disk media for development)
# Get these from Supabase project settings -> Storage -> S3 connection details
SUPABASE_STORAGE_BUCKET_NAME=
SUPABASE_STORAGE_ENDPOINT_URL=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_REGION=us-east-1
